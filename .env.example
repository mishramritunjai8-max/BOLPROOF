# BOLPROOF Environment Configuration Example
# Copy this file to .env and configure your local settings.
# IMPORTANT: Never commit .env with real credentials to source control.

# Backend Server Configuration
PORT=3001

# Allowed Frontend Origins for CORS (comma-separated, optional)
# Default allowlist includes localhost:3000, 127.0.0.1:3000, localhost:5173, 127.0.0.1:5173
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gnani AI Credentials (Server-side only — strictly kept private on the server)
# Endpoints:
# - Prisma STT: https://api.vachana.ai/stt/v3
# - Timbre TTS: https://api.vachana.ai/api/v1/tts/inference
# Authentication Header: X-API-Key-ID
GNANI_API_KEY=replace_with_your_key
